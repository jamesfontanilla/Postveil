{
  "name": "postveil",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:security && npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:spam && npm run test:delivery && npm run test:input && npm run test:renderer && npm run test:mfa && npm run test:platform && npm run test:storage-adapters && npm run test:local-store && npm run test:pdocs-truthfulness && npm run test:calendar-validation && npm run test:calendar-routes && npm run test:schemas && npm run test:sheets && npm run test:pdf-boundary",
    "test:sheets": "node --experimental-strip-types --test tests/sheets-formulas.test.ts",
    "test:schemas": "node --experimental-strip-types --test tests/pillar-wire-schemas.test.ts",
    "test:pdf-boundary": "node --experimental-strip-types --test tests/pdf-boundary.test.ts",
    "test:platform": "node --experimental-strip-types --test tests/postveil-platform.test.ts",
    "test:storage-adapters": "node --experimental-strip-types --test tests/storage-adapters.test.ts",
    "test:local-store": "node --experimental-strip-types --test tests/local-store.test.ts",
    "test:pdocs-truthfulness": "node --experimental-strip-types --test tests/pdocs-truthfulness.test.ts",
    "test:calendar-validation": "node --experimental-strip-types --test tests/calendar-validation.test.ts",
    "test:calendar-routes": "node --experimental-strip-types --test tests/calendar-routes.test.ts",
    "test:security": "node --experimental-strip-types --test tests/account-security.test.ts",
    "test:phase1": "node --experimental-strip-types --test tests/phase1-search.test.ts",
    "test:phase2": "node --experimental-strip-types --test tests/phase2-rules-work.test.ts",
    "test:phase3": "node --experimental-strip-types --test tests/phase3-send-attachments.test.ts",
    "test:phase4": "node --experimental-strip-types --test tests/phase4-trust-screening.test.ts",
    "test:spam": "node --experimental-strip-types --test tests/spam-hardening.test.ts",
    "test:delivery": "node --experimental-strip-types --test tests/delivery.test.ts",
    "test:input": "node --experimental-strip-types --test tests/input-security.test.ts",
    "test:renderer": "node --experimental-strip-types --test tests/email-renderer.test.ts",
    "test:mfa": "node --experimental-strip-types --test tests/mfa.test.ts",
    "test:prod": "node scripts/prod-smoke.mjs",
    "build:lambda-inbound": "npm --prefix lambda-inbound run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sesv2": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@types/katex": "^0.16.8",
    "@xmldom/xmldom": "^0.8.11",
    "dompurify": "^3.4.14",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "postal-mime": "^3.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/jszip": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.32.0"
  }
}
