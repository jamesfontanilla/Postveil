{
  "name": "postveil",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:security && npm run test:collaboration && npm run test:workspace && npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:delivery && npm run test:input && npm run test:renderer",
    "test:security": "node --experimental-strip-types --test tests/account-security.test.ts",
    "test:collaboration": "node --experimental-strip-types --test tests/collaboration.test.ts",
    "test:workspace": "node --experimental-strip-types --test tests/workspace.test.ts",
    "test:phase1": "node --experimental-strip-types --test tests/phase1-search.test.ts",
    "test:phase2": "node --experimental-strip-types --test tests/phase2-rules-work.test.ts",
    "test:phase3": "node --experimental-strip-types --test tests/phase3-send-attachments.test.ts",
    "test:phase4": "node --experimental-strip-types --test tests/phase4-trust-screening.test.ts",
    "test:phase5": "node --experimental-strip-types --test tests/phase5-automation.test.ts",
    "test:delivery": "node --experimental-strip-types --test tests/delivery.test.ts",
    "test:input": "node --experimental-strip-types --test tests/input-security.test.ts",
    "test:renderer": "node --experimental-strip-types --test tests/email-renderer.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sesv2": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@supabase/supabase-js": "^2.105.0",
    "@xmldom/xmldom": "^0.8.11",
    "dompurify": "^3.4.14",
    "lucide-react": "^0.468.0",
    "postal-mime": "^2.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.32.0"
  }
}
