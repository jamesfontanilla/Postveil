# Public browser configuration is intentionally empty: Postveil authenticates
# through its own D1-backed Worker session API.
APP_DOMAIN=your-domain.example
ALLOWED_SENDER_DOMAINS=your-domain.example
DEFAULT_FROM_EMAIL=postmaster@your-domain.example
SYSTEM_FROM_EMAIL=noreply@your-domain.example
SYSTEM_FROM_EMAIL=noreply@your-domain.example
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_BUCKET=your-private-bucket
AWS_SES_REGION=ap-southeast-1
INBOUND_MX_TARGETS=route1.mx.cloudflare.net,route2.mx.cloudflare.net,route3.mx.cloudflare.net,route4.mx.cloudflare.net
CLOUDFLARE_OAUTH_CLIENT_ID=server-only-cloudflare-oauth-client-id
CLOUDFLARE_OAUTH_CLIENT_SECRET=server-only-cloudflare-oauth-client-secret
# OAuth scopes required by the customer-domain DNS and inbound-route setup.
CLOUDFLARE_OAUTH_SCOPES=zone.read dns.read zone_settings.write email_routing_rules.write
CLOUDFLARE_EMAIL_WORKER_NAME=postveil

# Configure these as Cloudflare Worker secrets, never in the browser bundle.
B2_KEY_ID=server-only-b2-key-id
B2_APPLICATION_KEY=server-only-b2-application-key
AWS_ACCESS_KEY_ID=server-only-aws-access-key-id
AWS_SECRET_ACCESS_KEY=server-only-aws-secret-access-key
INBOUND_SHARED_SECRET=long-random-secret
SES_WEBHOOK_SECRET=long-random-secret
SES_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:account:postveil-ses-events
SES_CONFIGURATION_SET_NAME=postveil-events
# The site key is safe to publish; the secret must remain a Worker secret.
TURNSTILE_SITE_KEY=public-turnstile-site-key
TURNSTILE_SECRET_KEY=server-only-turnstile-secret
# Keep false in hosted environments until an antivirus scanner is configured.
ATTACHMENTS_ENABLED=false
CONFIDENTIAL_LINK_SECRET=long-random-secret-for-share-links
CONFIDENTIAL_ENCRYPTION_KEY=long-random-secret-for-share-payloads
MFA_ENCRYPTION_KEY=long-random-secret-for-encrypted-totp-secrets
OUTLOOK_FORWARD_TO=
